# Copy this file to `.env` and fill in the keys you actually use.
# Never commit the real .env to git.

# ---------------------------------------------------------------------------
# Decisions API client (src/decision_harness/decisions.py)
# ---------------------------------------------------------------------------
# API key for the Decisions service. Falls back to OPENAI_API_KEY if unset.
DECISIONS_API_KEY=

# Override the Decisions API base URL (optional; a default is built in).
# DECISIONS_BASE_URL=

# ---------------------------------------------------------------------------
# Model provider API keys (used by the model catalog, see
# src/decision_harness/data/default_catalog.json)
# Only fill in the providers you plan to use.
# ---------------------------------------------------------------------------
# OpenAI (also used as fallback for DECISIONS_API_KEY)
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Fireworks AI
FIREWORKS_API_KEY=

# Baseten
BASETEN_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
